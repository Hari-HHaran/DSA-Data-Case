# Copy to backend/.env and adjust. All variables are optional for a local demo.
LIVES_DATABASE_URL=sqlite:///./lives_one.db
LIVES_SECRET_KEY=replace-with-a-long-random-string
LIVES_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LIVES_DEMO_MODE=true
LIVES_DEMO_PASSWORD=lives-demo
LIVES_SAP_ADAPTER=mock
LIVES_NOTIFICATION_ADAPTER=mock
